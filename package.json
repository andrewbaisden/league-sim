{
  "name": "league-sim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @leaguesim/web dev",
    "dev:worker": "pnpm --filter @leaguesim/worker dev",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @leaguesim/web test:e2e",
    "db:generate": "pnpm --filter @leaguesim/db generate",
    "db:migrate": "pnpm --filter @leaguesim/db migrate",
    "db:seed": "pnpm --filter @leaguesim/db seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  }
}
